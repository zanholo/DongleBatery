<Window x:Class="MonitorBateria.UI.SidePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:MonitorBateria.Models"
        Title="Monitor de Bateria"
        Width="384" Height="700"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource Panel.Background}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource Panel.Text}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Card de dispositivo -->
        <DataTemplate x:Key="DeviceCard" DataType="{x:Type m:BatteryDevice}">
            <Border x:Name="card" Margin="0,0,0,8" Padding="12,12,8,12" CornerRadius="8"
                    Background="{DynamicResource Panel.Card}" BorderBrush="{DynamicResource Panel.Stroke}" BorderThickness="1">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Mostrar ícone próprio na bandeja" IsCheckable="True"
                                  IsChecked="{Binding ShowInTray, Mode=OneWay}" Click="TrayToggle_Click" />
                        <MenuItem Header="Usar no ícone principal da bandeja" IsCheckable="True"
                                  IsChecked="{Binding IsMainTray, Mode=OneWay}" Click="MainTray_Click" />
                        <MenuItem Header="Renomear…" Click="Rename_Click" />
                        <Separator />
                        <MenuItem Header="Ocultar do painel" Click="Hide_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ícone do tipo/modelo -->
                    <Grid VerticalAlignment="Top" Width="42" Height="42">
                        <Border CornerRadius="10" Background="{Binding ColorKey, Converter={StaticResource LevelBrushSoft}}" />
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="21"
                                   Foreground="{Binding ColorKey, Converter={StaticResource LevelBrush}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsEarbuds, Converter={StaticResource BoolVisInv}}" />
                        <Path Data="{StaticResource EarbudsGeometry}" Width="23" Height="23" Stretch="Uniform"
                              Stroke="{Binding ColorKey, Converter={StaticResource LevelBrush}}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding IsEarbuds, Converter={StaticResource BoolVis}}" />
                        <!-- selo de carregando -->
                        <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-5,-5" Background="{DynamicResource Level.charge}"
                                BorderBrush="{DynamicResource Panel.Background}" BorderThickness="2"
                                Visibility="{Binding IsCharging, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,6,0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Margin="6,1,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource Panel.CardHover}"
                                    Visibility="{Binding HasBrand, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Brand}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Panel.SubText}" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Panel.SubText}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,0,6,0">
                        <ProgressBar Style="{StaticResource BatteryBar}" Margin="0,8,0,0"
                                     Value="{Binding Level, Mode=OneWay, TargetNullValue=0}"
                                     Foreground="{Binding ColorKey, Converter={StaticResource LevelBrush}}"
                                     Visibility="{Binding HasLevel, Converter={StaticResource BoolVis}}" />

                        <ItemsControl ItemsSource="{Binding Parts}" Margin="0,8,0,0"
                                      Visibility="{Binding HasParts, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,0" Padding="7,2" CornerRadius="4" Background="{DynamicResource Panel.CardHover}">
                                        <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{DynamicResource Panel.SubText}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,7,0,0">
                            <TextBlock Text="{Binding StateGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{Binding ColorKey, Converter={StaticResource LevelBrush}}" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Panel.SubText}"
                                       Margin="6,0,0,0" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,0,0,-4">
                        <TextBlock Text="{Binding LevelText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Margin="0,-3,4,0" Foreground="{Binding ColorKey, Converter={StaticResource LevelBrush}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE7F4;"
                                          IsChecked="{Binding ShowInTray, Mode=OneWay}" Click="TrayToggle_Click"
                                          ToolTip="Mostrar ícone próprio na barra de tarefas" />
                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                                    Foreground="{DynamicResource Panel.SubText}" Content="&#xED1A;"
                                    Click="Hide_Click" ToolTip="Ocultar do painel" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter TargetName="card" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Linha compacta para dispositivos ocultos -->
        <DataTemplate x:Key="HiddenRow" DataType="{x:Type m:BatteryDevice}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="{DynamicResource Panel.SubText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontSize="12.5" Margin="8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Panel.SubText}" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                        Content="&#xE7B3;" Click="Unhide_Click" ToolTip="Mostrar no painel" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
        <Border x:Name="Sheet" Background="{DynamicResource Panel.Background}" BorderBrush="{DynamicResource Panel.Stroke}" BorderThickness="1,0,0,0">
            <DockPanel x:Name="Body">
                <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="Slide" />
                </DockPanel.RenderTransform>
                <!-- Cabeçalho -->
                <Grid DockPanel.Dock="Top" Margin="18,14,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TitleText" Text="Dispositivos" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="SubtitleText" Text="Procurando dispositivos…" FontSize="12"
                                   Foreground="{DynamicResource Panel.SubText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="Atualizar agora" />
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Configurações" />
                        <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Width="34" Height="34" FontSize="15"
                                      Foreground="{DynamicResource Panel.Text}"
                                      Content="&#xE718;" Click="Pin_Click" ToolTip="Manter o painel aberto" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="12" Click="Close_Click" ToolTip="Fechar" />
                    </StackPanel>
                </Grid>

                <!-- Rodapé -->
                <TextBlock DockPanel.Dock="Bottom" x:Name="FooterText" Margin="18,6,18,12" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Panel.SubText}"
                           Text="Clique com o botão direito em um dispositivo para mais opções." />

                <Grid>
                    <!-- ===== Página: dispositivos ===== -->
                    <ScrollViewer x:Name="DevicesPage" VerticalScrollBarVisibility="Auto" Padding="14,8,14,0">
                        <StackPanel>
                            <ItemsControl x:Name="DeviceList" ItemTemplate="{StaticResource DeviceCard}" />

                            <Border x:Name="EmptyState" Padding="16,28" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="36" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Panel.SubText}" />
                                    <TextBlock Text="Nenhum dispositivo para mostrar" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center" />
                                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource Panel.SubText}"
                                               Text="Conecte um dispositivo Bluetooth com bateria (fone, mouse, teclado, controle…) ou reexiba os ocultos abaixo." />
                                </StackPanel>
                            </Border>

                            <Expander x:Name="HiddenExpander" Margin="0,4,0,12" Header="Ocultos" Visibility="Collapsed">
                                <ItemsControl x:Name="HiddenList" Margin="4,8,0,0" ItemTemplate="{StaticResource HiddenRow}" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Página: configurações ===== -->
                    <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Padding="18,0,18,0" Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="POSIÇÃO DO PAINEL" />
                            <TextBlock Text="Monitor" FontSize="13" Margin="0,0,0,4" />
                            <ComboBox x:Name="MonitorCombo" HorizontalAlignment="Stretch" SelectionChanged="MonitorCombo_SelectionChanged" />
                            <Button x:Name="IdentifyButton" Content="Identificar monitores" Margin="0,8,0,0" HorizontalAlignment="Left" Click="Identify_Click" />
                            <TextBlock Text="Lado da tela" FontSize="13" Margin="0,12,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SideRight" Content="Direita" GroupName="side" Margin="0,0,16,0" Checked="Side_Checked" />
                                <RadioButton x:Name="SideLeft" Content="Esquerda" GroupName="side" Checked="Side_Checked" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="COMPORTAMENTO" />
                            <CheckBox x:Name="AutoHideCheck" Content="Fechar o painel ao clicar fora" Click="Option_Changed" />
                            <CheckBox x:Name="ShowDisconnectedCheck" Content="Mostrar dispositivos desconectados" Margin="0,6,0,0" Click="Option_Changed" />
                            <CheckBox x:Name="StartupCheck" Content="Iniciar junto com o Windows" Margin="0,6,0,0" Click="Startup_Click" />
                            <TextBlock Text="Atualizar a cada" FontSize="13" Margin="0,12,0,4" />
                            <ComboBox x:Name="IntervalCombo" SelectionChanged="Interval_SelectionChanged">
                                <ComboBoxItem Content="10 segundos" Tag="10" />
                                <ComboBoxItem Content="30 segundos" Tag="30" />
                                <ComboBoxItem Content="1 minuto" Tag="60" />
                                <ComboBoxItem Content="2 minutos" Tag="120" />
                                <ComboBoxItem Content="5 minutos" Tag="300" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="BARRA DE TAREFAS E WIDGET" />
                            <CheckBox x:Name="PromoteCheck" Content="Ícones sempre visíveis na barra (fora do menu ^)" Click="Option_Changed" />
                            <CheckBox x:Name="WidgetCheck" Content="Widget flutuante (arraste para qualquer lugar)" Margin="0,6,0,10" Click="Option_Changed" />
                            <TextBlock Text="O ícone principal mostra" FontSize="13" Margin="0,0,0,4" />
                            <ComboBox x:Name="MainTrayCombo" DisplayMemberPath="Label" SelectionChanged="MainTray_SelectionChanged" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="ALERTAS" />
                            <CheckBox x:Name="AlertCheck" Content="Avisar quando a bateria estiver fraca" Click="Option_Changed" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ThresholdText" DockPanel.Dock="Right" Width="42" TextAlignment="Right" FontSize="13" VerticalAlignment="Center" />
                                <Slider x:Name="ThresholdSlider" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="Threshold_Changed" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="DISPOSITIVOS ENCONTRADOS" />
                            <TextBlock Text="Escolha o que aparece no painel e quais ganham um ícone próprio na barra de tarefas." FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Panel.SubText}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="AllDevicesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:BatteryDevice}">
                                        <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource Panel.Card}"
                                                BorderBrush="{DynamicResource Panel.Stroke}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                                           Foreground="{Binding ColorKey, Converter={StaticResource LevelBrush}}" />
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}" FontSize="12.5" Foreground="{DynamicResource Panel.SubText}" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource Panel.SubText}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <CheckBox Content="No painel" IsChecked="{Binding IsHidden, Mode=OneWay, Converter={StaticResource InvertBool}}"
                                                                  Click="VisibleCheck_Click" Margin="0,0,14,0" MinWidth="0" />
                                                        <CheckBox Content="Ícone na barra" IsChecked="{Binding ShowInTray, Mode=OneWay}"
                                                                  Click="TrayToggle_Click" MinWidth="0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="SOBRE" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Panel.SubText}"
                                       Text="A bateria é lida do Windows (Bluetooth clássico e LE), do serviço de bateria GATT, de controles XInput e da bateria do próprio PC. Carregando/descarregando é detectado pela variação do nível quando o dispositivo não informa." />
                            <Button Content="Sair do Monitor de Bateria" Margin="0,14,0,0" HorizontalAlignment="Left" Click="Exit_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
