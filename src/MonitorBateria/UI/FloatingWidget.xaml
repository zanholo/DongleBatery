<Window x:Class="MonitorBateria.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:MonitorBateria.Models"
        Title="Monitor de Bateria — widget"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource Panel.Text}"
        UseLayoutRounding="True">

    <Border x:Name="Frame" CornerRadius="10" Padding="6,5,10,5" Margin="6"
            Background="{DynamicResource Panel.Background}" BorderBrush="{DynamicResource Panel.Stroke}" BorderThickness="1"
            MouseLeftButtonDown="Frame_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Abrir painel" Click="OpenPanel_Click" FontWeight="SemiBold" />
                <Separator />
                <MenuItem x:Name="VerticalItem" Header="Layout vertical" IsCheckable="True" Click="Vertical_Click" />
                <MenuItem x:Name="NamesItem" Header="Mostrar nomes" IsCheckable="True" Click="Names_Click" />
                <MenuItem x:Name="TopmostItem" Header="Sempre por cima das janelas" IsCheckable="True" Click="Topmost_Click" />
                <MenuItem Header="Voltar para a posição padrão" Click="ResetPosition_Click" />
                <MenuItem Header="Dica: arraste para cima da barra de tarefas para encaixar nela" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Ocultar widget" Click="HideWidget_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <DockPanel>
            <!-- alça de arrastar -->
            <TextBlock DockPanel.Dock="Left" x:Name="Grip" Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                       Foreground="{DynamicResource Panel.SubText}" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.7" />

            <Grid>
                <TextBlock x:Name="EmptyText" Text="Nenhum dispositivo conectado" FontSize="12" Margin="2,2"
                           Foreground="{DynamicResource Panel.SubText}" VerticalAlignment="Center" Visibility="Collapsed" />
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel x:Name="ItemsHost" Orientation="Horizontal" Loaded="ItemsHost_Loaded" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:BatteryDevice}">
                            <StackPanel Orientation="Horizontal" Margin="4,3,8,3" Background="Transparent">
                                <StackPanel.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" />
                                        <TextBlock Text="{Binding StatusText}" />
                                    </StackPanel>
                                </StackPanel.ToolTip>
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{Binding ColorKey, Converter={StaticResource LevelBrush}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsEarbuds, Converter={StaticResource BoolVisInv}}" />
                                    <Path Data="{StaticResource EarbudsGeometry}" Width="17" Height="17" Stretch="Uniform"
                                          Stroke="{Binding ColorKey, Converter={StaticResource LevelBrush}}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding IsEarbuds, Converter={StaticResource BoolVis}}" />
                                </Grid>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Panel.SubText}"
                                           Visibility="{Binding DataContext.ShowNames, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding LevelText}" FontSize="13.5" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding ColorKey, Converter={StaticResource LevelBrush}}" />
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="3,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Level.charge}" ToolTip="Carregando"
                                           Visibility="{Binding IsCharging, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DockPanel>
    </Border>
</Window>
